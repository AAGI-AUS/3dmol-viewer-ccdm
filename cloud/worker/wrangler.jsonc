{
  // PPI viewer on Cloudflare: one Worker that serves public/ as static assets
  // and answers /api/* itself. Deploy with `npx wrangler deploy` from this folder.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ppi-viewer",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "STRUCTURES", "bucket_name": "ppi-structures" }
  ],
  // Both values are public by design: the anon/publishable key only grants
  // what row-level security allows, which is nothing until a user signs in.
  "vars": {
    "SUPABASE_URL": "https://huvtngavcatlbqwltvco.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imh1dnRuZ2F2Y2F0bGJxd2x0dmNvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUwNjA3OTksImV4cCI6MjExMDYzNjc5OX0.GeaBh9izvGB0-VubbQuD4fdwpySDxuyGjp80Tg_XYkM"
  },
  "observability": { "enabled": true }
}
