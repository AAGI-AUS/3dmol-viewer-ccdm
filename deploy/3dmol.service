[Unit]
Description=3Dmol Protein Structure Viewer
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/3dmol-app
ExecStart=/usr/bin/node server.js
Restart=on-failure
Environment=PORT=3000
Environment=AFM_DIR=/mnt/3dmol/test_data/AFM
# Required — set your own values, never commit these:
Environment=ADMIN_PASSWORD=change-me
Environment=JWT_SECRET=change-me

[Install]
WantedBy=multi-user.target
